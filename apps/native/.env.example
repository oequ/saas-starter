# Copy to `.env` and fill from `npm run db:status` (repo root) or hosted project API settings.
# Restart Expo after changing env (`npx expo start -c`).

# Local Supabase API (Docker). On a physical phone use your PC LAN IP, e.g. http://192.168.1.10:54321
# Android emulator often needs http://10.0.2.2:54321 instead of 127.0.0.1
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable / anon key from db:status (or Dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Must match supabase/config.toml [auth.email] enable_confirmations (default true)
EXPO_PUBLIC_SUPABASE_REQUIRE_EMAIL_CONFIRMATION=true
